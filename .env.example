COMPOSE_PROJECT_NAME=mcp-tw-opendata

POSTGRES_DB=tw_opendata
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# 主機對外 port（容器內部 port 固定 5432/8000）
PG_HOST_PORT=5432
MCP_HOST_PORT=8000

TZ=Asia/Taipei
SYNC_CRON=0 3 * * *
# (選填) Telegram 推播通知設定
# 如果有填寫，當系統抓取到新資料集或官方有更新時，會自動傳送訊息給你
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
